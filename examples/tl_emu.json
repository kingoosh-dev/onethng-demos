{"caps": [{"t0": 0.302, "t1": 1.237, "text": "IN 1932,", "s": 0}, {"t0": 1.237, "t1": 3.276, "text": "AUSTRALIA WENT TO WAR", "s": 0}, {"t0": 3.276, "t1": 4.465, "text": "WITH BIRDS.", "s": 0}, {"t0": 4.465, "t1": 5.692, "text": "AND LOST.", "s": 0}, {"t0": 5.692, "t1": 6.822, "text": "ABOUT 20,000 EMUS", "s": 1}, {"t0": 6.822, "t1": 7.612, "text": "HAD INVADED", "s": 1}, {"t0": 7.612, "t1": 8.629, "text": "THE WHEAT FARMS", "s": 1}, {"t0": 8.629, "t1": 10.191, "text": "OF WESTERN AUSTRALIA.", "s": 1}, {"t0": 10.191, "t1": 11.046, "text": "THE FARMERS", "s": 2}, {"t0": 11.046, "t1": 12.267, "text": "WERE EX-SOLDIERS.", "s": 2}, {"t0": 12.267, "t1": 13.244, "text": "SO THEY ASKED", "s": 2}, {"t0": 13.244, "t1": 14.673, "text": "FOR MACHINE GUNS.", "s": 2}, {"t0": 14.673, "t1": 15.442, "text": "THE GOVERNMENT", "s": 3}, {"t0": 15.442, "t1": 16.192, "text": "SAID YES.", "s": 3}, {"t0": 16.192, "t1": 17.404, "text": "A MAJOR ARRIVED", "s": 4}, {"t0": 17.404, "t1": 18.819, "text": "WITH TWO SOLDIERS,", "s": 4}, {"t0": 18.819, "t1": 20.032, "text": "TWO LEWIS GUNS,", "s": 4}, {"t0": 20.032, "t1": 21.655, "text": "AND 10,000 ROUNDS.", "s": 4}, {"t0": 21.655, "t1": 22.767, "text": "THE EMUS SPLIT", "s": 5}, {"t0": 22.767, "t1": 24.141, "text": "INTO SMALL GROUPS.", "s": 5}, {"t0": 24.141, "t1": 25.722, "text": "THEN A GUN JAMMED.", "s": 5}, {"t0": 25.722, "t1": 26.842, "text": "IN THE FIRST AMBUSH,", "s": 6}, {"t0": 26.842, "t1": 27.378, "text": "THEY GOT", "s": 6}, {"t0": 27.378, "t1": 28.462, "text": "ABOUT 12 BIRDS.", "s": 6}, {"t0": 28.462, "t1": 29.245, "text": "WITHIN A WEEK,", "s": 7}, {"t0": 29.245, "t1": 29.752, "text": "THE ARMY", "s": 7}, {"t0": 29.752, "t1": 30.788, "text": "WAS PULLED OUT.", "s": 7}, {"t0": 30.788, "t1": 32.182, "text": "THEN SENT BACK IN.", "s": 8}, {"t0": 32.182, "t1": 33.078, "text": "BY DECEMBER,", "s": 9}, {"t0": 33.078, "t1": 34.391, "text": "THEY'D FIRED NEARLY", "s": 9}, {"t0": 34.391, "t1": 35.613, "text": "10,000 ROUNDS.", "s": 9}, {"t0": 35.613, "t1": 36.693, "text": "THE MAJOR CLAIMED", "s": 10}, {"t0": 36.693, "t1": 37.827, "text": "UNDER 1,000 KILLS.", "s": 10}, {"t0": 37.827, "t1": 38.853, "text": "HISTORIANS THINK", "s": 10}, {"t0": 38.853, "t1": 39.501, "text": "EVEN THAT", "s": 10}, {"t0": 39.501, "t1": 40.573, "text": "WAS GENEROUS.", "s": 10}, {"t0": 40.573, "t1": 41.325, "text": "HIS VERDICT?", "s": 11}, {"t0": 41.325, "t1": 42.177, "text": "\u201cTHEY CAN FACE", "s": 11}, {"t0": 42.177, "t1": 42.929, "text": "MACHINE GUNS", "s": 11}, {"t0": 42.929, "t1": 44.283, "text": "WITH THE INVULNERABILITY", "s": 11}, {"t0": 44.283, "t1": 45.143, "text": "OF TANKS.\u201d", "s": 11}, {"t0": 45.143, "t1": 45.775, "text": "THE ARMY", "s": 12}, {"t0": 45.775, "t1": 46.866, "text": "NEVER WENT BACK.", "s": 12}, {"t0": 46.866, "t1": 47.498, "text": "THE EMUS", "s": 12}, {"t0": 47.498, "t1": 48.796, "text": "ARE STILL THERE.", "s": 12}, {"t0": 48.796, "t1": 49.938, "text": "A TRAINED ARMY LOST,", "s": 13}, {"t0": 49.938, "t1": 51.328, "text": "BECAUSE IT UNDERESTIMATED", "s": 13}, {"t0": 51.328, "t1": 52.023, "text": "WHAT IT WAS", "s": 13}, {"t0": 52.023, "t1": 52.926, "text": "UP AGAINST.", "s": 13}, {"t0": 52.926, "t1": 54.047, "text": "MOST ONLINE STORES", "s": 14}, {"t0": 54.047, "t1": 55.589, "text": "MAKE THE SAME MISTAKE.", "s": 14}, {"t0": 55.589, "t1": 56.517, "text": "SHOPPERS DECIDE", "s": 15}, {"t0": 56.517, "t1": 57.238, "text": "WHO YOU ARE", "s": 15}, {"t0": 57.238, "t1": 58.167, "text": "IN SECONDS.", "s": 15}, {"t0": 58.167, "t1": 58.984, "text": "IF YOUR HOMEPAGE", "s": 16}, {"t0": 58.984, "t1": 59.543, "text": "LOOKS LIKE", "s": 16}, {"t0": 59.543, "t1": 60.446, "text": "EVERY OTHER STORE,", "s": 16}, {"t0": 60.446, "t1": 61.219, "text": "THAT'S THE ONLY", "s": 16}, {"t0": 61.219, "t1": 62.373, "text": "IMPRESSION YOU GET.", "s": 16}, {"t0": 62.373, "t1": 63.171, "text": "A 3D HERO", "s": 17}, {"t0": 63.171, "t1": 65.042, "text": "THAT STOPS THE SCROLL.", "s": 17}, {"t0": 65.042, "t1": 65.996, "text": "A BUNDLE BUILDER", "s": 18}, {"t0": 65.996, "t1": 67.51, "text": "THAT GROWS EVERY ORDER.", "s": 18}, {"t0": 67.51, "t1": 68.865, "text": "AND A FIRST-ORDER POPUP", "s": 19}, {"t0": 68.865, "t1": 70.012, "text": "THAT TURNS VISITORS", "s": 19}, {"t0": 70.012, "t1": 71.001, "text": "INTO BUYERS.", "s": 19}, {"t0": 71.001, "t1": 71.825, "text": "DROP THEM INTO", "s": 20}, {"t0": 71.825, "t1": 72.407, "text": "THE THEME", "s": 20}, {"t0": 72.407, "t1": 73.377, "text": "YOU ALREADY HAVE.", "s": 20}, {"t0": 73.377, "t1": 74.506, "text": "NO MONTHLY APPS.", "s": 20}, {"t0": 74.506, "t1": 76.105, "text": "LINK IN BIO.", "s": 21}], "sent": [{"i": 0, "t0": 0.283, "t1": 5.513}, {"i": 1, "t0": 5.673, "t1": 10.012}, {"i": 2, "t0": 10.173, "t1": 14.494}, {"i": 3, "t0": 14.654, "t1": 16.012}, {"i": 4, "t0": 16.173, "t1": 21.475}, {"i": 5, "t0": 21.636, "t1": 25.543}, {"i": 6, "t0": 25.703, "t1": 28.283}, {"i": 7, "t0": 28.443, "t1": 30.609}, {"i": 8, "t0": 30.769, "t1": 32.003}, {"i": 9, "t0": 32.163, "t1": 35.434}, {"i": 10, "t0": 35.594, "t1": 40.393}, {"i": 11, "t0": 40.554, "t1": 44.964}, {"i": 12, "t0": 45.124, "t1": 48.617}, {"i": 13, "t0": 48.778, "t1": 52.746}, {"i": 14, "t0": 52.907, "t1": 55.41}, {"i": 15, "t0": 55.57, "t1": 57.988}, {"i": 16, "t0": 58.148, "t1": 62.193}, {"i": 17, "t0": 62.354, "t1": 64.862}, {"i": 18, "t0": 65.023, "t1": 67.331}, {"i": 19, "t0": 67.491, "t1": 70.822}, {"i": 20, "t0": 70.982, "t1": 74.327}, {"i": 21, "t0": 74.487, "t1": 75.35}], "total": 76.105}