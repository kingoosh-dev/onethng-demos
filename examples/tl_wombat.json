{"caps": [{"t0": 0.311, "t1": 1.472, "text": "THERE'S AN ANIMAL", "s": 0}, {"t0": 1.472, "t1": 2.343, "text": "IN AUSTRALIA", "s": 0}, {"t0": 2.343, "t1": 3.04, "text": "THAT POOS", "s": 0}, {"t0": 3.04, "t1": 4.415, "text": "IN PERFECT CUBES.", "s": 0}, {"t0": 4.415, "t1": 5.395, "text": "NOT ROUND.", "s": 1}, {"t0": 5.395, "t1": 6.602, "text": "NOT SQUASHED.", "s": 1}, {"t0": 6.602, "t1": 7.494, "text": "CUBES.", "s": 1}, {"t0": 7.494, "t1": 8.242, "text": "FOR YEARS,", "s": 2}, {"t0": 8.242, "t1": 9.105, "text": "NOBODY COULD", "s": 2}, {"t0": 9.105, "t1": 10.182, "text": "EXPLAIN HOW.", "s": 2}, {"t0": 10.182, "t1": 11.293, "text": "THEN AN ENGINEER", "s": 3}, {"t0": 11.293, "t1": 12.58, "text": "NAMED PATRICIA YANG", "s": 3}, {"t0": 12.58, "t1": 14.139, "text": "DECIDED TO FIND OUT.", "s": 3}, {"t0": 14.139, "t1": 15.218, "text": "HER TEAM STUDIED", "s": 4}, {"t0": 15.218, "t1": 16.41, "text": "WOMBAT INTESTINES.", "s": 4}, {"t0": 16.41, "t1": 17.376, "text": "MEASURED THEM.", "s": 4}, {"t0": 17.376, "t1": 18.398, "text": "STRETCHED THEM.", "s": 4}, {"t0": 18.398, "t1": 19.647, "text": "EVEN INFLATED THEM,", "s": 4}, {"t0": 19.647, "t1": 20.826, "text": "LIKE BALLOONS.", "s": 4}, {"t0": 20.826, "t1": 21.488, "text": "FOR MOST OF", "s": 5}, {"t0": 21.488, "t1": 22.197, "text": "THE JOURNEY,", "s": 5}, {"t0": 22.197, "t1": 23.545, "text": "IT'S A LIQUID SLURRY.", "s": 5}, {"t0": 23.545, "t1": 24.915, "text": "THEN, IN THE LAST 8%", "s": 6}, {"t0": 24.915, "t1": 25.749, "text": "OF THE GUT,", "s": 6}, {"t0": 25.749, "t1": 26.463, "text": "THE WALLS", "s": 6}, {"t0": 26.463, "t1": 27.654, "text": "STRETCH UNEVENLY,", "s": 6}, {"t0": 27.654, "t1": 28.667, "text": "AND SQUEEZE IT", "s": 6}, {"t0": 28.667, "t1": 29.834, "text": "INTO CORNERS.", "s": 6}, {"t0": 29.834, "t1": 31.06, "text": "ONE WOMBAT MAKES", "s": 7}, {"t0": 31.06, "t1": 32.48, "text": "80 TO 100 OF THESE,", "s": 7}, {"t0": 32.48, "t1": 33.662, "text": "EVERY NIGHT.", "s": 7}, {"t0": 33.662, "t1": 34.377, "text": "EACH ONE,", "s": 8}, {"t0": 34.377, "t1": 35.961, "text": "NEARLY AN INCH WIDE.", "s": 8}, {"t0": 35.961, "t1": 36.678, "text": "THEY USE THEM", "s": 9}, {"t0": 36.678, "t1": 37.127, "text": "TO MARK", "s": 9}, {"t0": 37.127, "t1": 37.979, "text": "THEIR TERRITORY.", "s": 9}, {"t0": 37.979, "t1": 38.786, "text": "AND THE CORNERS", "s": 9}, {"t0": 38.786, "t1": 39.325, "text": "MEAN THEY", "s": 9}, {"t0": 39.325, "t1": 40.39, "text": "DON'T ROLL AWAY.", "s": 9}, {"t0": 40.39, "t1": 41.494, "text": "THE RESEARCH WON", "s": 10}, {"t0": 41.494, "t1": 42.926, "text": "AN IG NOBEL PRIZE.", "s": 10}, {"t0": 42.926, "t1": 43.813, "text": "A SHY ANIMAL", "s": 11}, {"t0": 43.813, "t1": 44.876, "text": "NOBODY NOTICES.", "s": 11}, {"t0": 44.876, "t1": 45.822, "text": "UNTIL YOU SEE", "s": 11}, {"t0": 45.822, "t1": 47.512, "text": "WHAT IT LEAVES BEHIND.", "s": 11}, {"t0": 47.512, "t1": 48.209, "text": "STAND OUT,", "s": 12}, {"t0": 48.209, "t1": 48.906, "text": "AND PEOPLE", "s": 12}, {"t0": 48.906, "t1": 49.764, "text": "REMEMBER YOU.", "s": 12}, {"t0": 49.764, "t1": 50.408, "text": "BLEND IN,", "s": 12}, {"t0": 50.408, "t1": 51.908, "text": "AND YOU'RE FORGOTTEN.", "s": 12}, {"t0": 51.908, "t1": 52.864, "text": "SHOPPERS DECIDE", "s": 13}, {"t0": 52.864, "t1": 53.608, "text": "WHO YOU ARE", "s": 13}, {"t0": 53.608, "t1": 54.566, "text": "IN SECONDS.", "s": 13}, {"t0": 54.566, "t1": 55.393, "text": "IF YOUR HOMEPAGE", "s": 14}, {"t0": 55.393, "t1": 55.959, "text": "LOOKS LIKE", "s": 14}, {"t0": 55.959, "t1": 56.873, "text": "EVERY OTHER STORE,", "s": 14}, {"t0": 56.873, "t1": 57.657, "text": "THAT'S THE ONLY", "s": 14}, {"t0": 57.657, "t1": 58.829, "text": "IMPRESSION YOU GET.", "s": 14}, {"t0": 58.829, "t1": 59.656, "text": "A 3D HERO", "s": 15}, {"t0": 59.656, "t1": 61.592, "text": "THAT STOPS THE SCROLL.", "s": 15}, {"t0": 61.592, "t1": 62.605, "text": "A BUNDLE BUILDER", "s": 16}, {"t0": 62.605, "t1": 64.204, "text": "THAT GROWS EVERY ORDER.", "s": 16}, {"t0"