<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- elsif settings.use_brand_logo -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'logo-mark.svg' | asset_url }}">
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'rebrand.css' | asset_url | stylesheet_tag }}
    <link rel="preload" as="font" type="font/woff2" crossorigin href="{{ 'outfit-600.woff2' | asset_url }}">

    <script>
      document.documentElement.classList.replace('no-js', 'js');
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          search: {{ routes.search_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }},
        settings: {
          cartType: {{ settings.cart_type | json }},
          smoothScroll: {{ settings.smooth_scroll | json }},
          scrollSmoothness: {{ settings.scroll_smoothness | json }},
          reveal: {{ settings.reveal_animations | json }},
          magnetic: {{ settings.magnetic_buttons | json }},
          enable3d: {{ settings.enable_3d | json }}
        },
        strings: {
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          soldOut: {{ 'products.product.sold_out' | t | json }},
          unavailable: {{ 'products.product.unavailable' | t | json }},
          adding: {{ 'products.product.adding' | t | json }},
          added: {{ 'products.product.added' | t | json }},
          cartError: {{ 'cart.general.error' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'rebrand.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}">
    {% render 'brand-logo-defs' %}
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.cart_type == 'drawer' -%}
      {% section 'cart-drawer' %}
    {%- endif -%}

    <div class="toast" role="status" aria-live="polite" data-toast hidden></div>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ request.origin | append: routes.root_url | json }}
        {%- if settings.logo -%},
          "logo": {{ settings.logo | image_url: width: 512 | prepend: 'https:' | json }}
        {%- elsif settings.use_brand_logo -%},
          "logo": {{ 'logo.png' | asset_url | prepend: 'https:' | json }}
        {%- endif -%}
        {%- if settings.social_instagram_link != blank -%},
          "sameAs": [{{ settings.social_instagram_link | json }}]
        {%- endif %}
      }
    </script>
  </body>
</html>
